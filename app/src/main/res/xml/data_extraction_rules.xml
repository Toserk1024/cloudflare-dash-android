<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- 排除加密凭据存储：恢复备份时 MasterKey 不匹配会导致无法解密 -->
        <exclude domain="sharedpref" path="cf_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cf_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>